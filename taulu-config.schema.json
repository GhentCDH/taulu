  "description": "Configuration for :class:`~taulu.Taulu`.\n\nAll parameters mirror the ``Taulu.__init__`` signature. Any parameter that\naccepts a ``Split[T]`` can be given as a ``Split`` instance or as a plain\nscalar (applied to both sides).\n\nUse :meth:`from_toml` to load from a ``.toml`` file, then pass to\n:meth:`Taulu.from_config <taulu.Taulu.from_config>`.",
  "properties": {
    "template_path": {
      "$ref": "#/$defs/Splittable_str_",
      "description": "Path to header template image(s). Use left/right split for two-page tables."
    },
    "row_height_factor": {
      "anyOf": [
        {
          "$ref": "#/$defs/Splittable_float_"
        },
        {
          "$ref": "#/$defs/Splittable_list_float__"
